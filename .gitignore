__pycache__/
*.pyc
.venv/
# Medições e ficheiros de trabalho das revisões (nunca vão para o repo).
_scratch/

# O catálogo Scryfall é reconstruível e grande de mais para o Git.
data/catalog.db
data/catalog.db-*
data/*.db-wal
data/*.db-shm
# O vault.db vive num Release (tag 'data'), não no Git — ver scripts/README.md.
data/vault.db
# O token de escrita do modo edição: é um segredo DESTA máquina, não uma
# preferência que viaje no Git (quem o tiver pode gravar a partir da rede local).
data/webapp.token
# O registo de vendas: histórico local do que saiu da colecção (data, carta,
# edição, língua, acabamento, quantidade, preço). Não vai para um repo público.
data/vendas.csv
# O registo do «já a tenho, está no deck»: que cartas ele declarou ter em casa,
# em que caixa as pôs e com que edição (palpite ou escolhida). É o rasto de um
# botão que CRIA cópias — sem ele, daqui a um mês não há como saber donde veio
# uma cópia sem foto. Local, como o de vendas.
data/registos-faltas.csv
# O registo do «não encontrei estas»: que cópias saíram da colecção por não
# estarem na estante, em que caixa faltaram e com que foto de origem — e as que
# voltaram pelo «afinal encontrei». É o inverso do de cima e o rasto de um botão
# que tira cartas de circulação. Local, como os outros dois.
data/nao-encontradas.csv
# Quem entrou em que caixa, quando e por que clique (`registar` do botão, o
# auto-registo, o "actualizei" e o "já arrumei tudo"). É a prova de que uma
# cópia dentro de uma caixa veio de um gesto dele: sem linha aqui, é bug.
data/registos-caixas.csv
# O backup que a `migrar-caixas` deixa ao lado. Serve para desfazer à mão na
# hora; o histórico do Git já guarda a versão anterior do config.
colecao_config-v5-*.json
cache/
priceguide.json

# Fotos da coleção — grandes e não pertencem ao Git (o inventário fica em owned.csv/vault.db)
fotos/
# As PASTAS de fotos (estrutura + .gitkeep/LEIA-ME) viajam com o repo; só as IMAGENS ficam de fora:
Colocar fotos da coleção aqui/**/*.jpg
Colocar fotos da coleção aqui/**/*.jpeg
Colocar fotos da coleção aqui/**/*.png
Colocar fotos da coleção aqui/**/*.heic
Colocar fotos da coleção aqui/**/*.webp
Colocar fotos da coleção aqui/**/*.gif
Fotos processadas da coleção/**/*.jpg
Fotos processadas da coleção/**/*.jpeg
Fotos processadas da coleção/**/*.png
Fotos processadas da coleção/**/*.heic
Fotos processadas da coleção/**/*.webp
Fotos processadas da coleção/**/*.gif
# Fotos em pendentes/ nunca vão para o repo (só o LEIA-ME viaja):
pendentes/**/*.jpg
pendentes/**/*.jpeg
pendentes/**/*.png
pendentes/**/*.heic
pendentes/**/*.webp
pendentes/**/*.gif

# backups diarios da BD feitos pelo ai-pc (mtgvault-daily / mtg-fotos)
data/backups/
data/vault.db.download

# ---------------------------------------------------------------------------
# Ruído do `git status` (2026-09-09). Nenhum destes ficheiros era para ir no Git,
# e cinco linhas de `??` permanentes fazem com que se deixe de olhar para o
# `git status` — que é onde uma alteração a sério se vê.
# ---------------------------------------------------------------------------
# Gerado todos os dias pelo `core_decks.py` (que continua a correr, para o
# card_price/posse) mas NUNCA publicado: saiu do `git add` a 2026-08-26, quando a
# página foi apagada para ser redefinida. Se voltar ao menu, sai daqui.
coredecks.html
# Registos locais do modo edição (`webapp.log`) e do «desmontar». O que é preciso
# guardar do desmontar já vai no backup da base que ele faz.
data/*.log
# Backups que os comandos deixam ao lado do config antes de lhe mexer (o
# `migrar-caixas` já tinha regra própria; o `desmontar` não tinha).
*.bak
# Recortes de fotos feitos à mão durante a catalogação. São imagens, e as imagens
# nunca vão para o repo.
scratchpad_crops/
